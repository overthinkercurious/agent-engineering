# Installed skills are a dependency, not your code. They are restored with one
# command, so they do not belong in your history. Ignoring by the ae- prefix
# rather than ignoring the whole directory means any skills YOU write stay
# tracked.
#
#   npx skills add __KIT_REPO__ --copy -y
#
.claude/skills/ae-*/
.agents/skills/ae-*/

# Generated runtime copy of the kit. Rewritten every time setup runs.
.dev/kit/

# Working zones: the contents are disposable, the directories are structure.
# Ignoring the directory outright would drop its .gitkeep and a fresh clone
# would fail its own install check.
.dev/scratch/*
.dev/context/*
.dev/evidence/*
!.dev/scratch/.gitkeep
!.dev/context/.gitkeep
!.dev/evidence/.gitkeep
