{
  "agent-engineering": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \".agents/skills/ae-forge/scripts/guard.mjs\" antigravity-pre-invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \".agents/skills/ae-forge/scripts/guard.mjs\" antigravity-pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
