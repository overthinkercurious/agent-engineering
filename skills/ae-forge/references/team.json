      "emit": [
        "database-performance",
        "query",
        "index"
      ]
    },
    {
      "when_schema": true,
      "emit": [
        "database-performance",
        "query",
        "schema"
      ]
    },
    {
      "when_routes": true,
      "emit": [
        "api",
        "contract",
        "endpoint"
      ]
    },
    {
      "when_imports": [
        "express",
        "fastify",
        "koa",
        "hapi",
        "nestjs",
        "@nestjs/core",
        "flask",
        "django",
        "fastapi",
        "gin",
        "rails"
      ],
      "emit": [
        "api",
        "endpoint"
      ]
    },
    {
      "when_paths": [
        "\\.tf$",
        "\\.tfvars$",
        "dockerfile",
        "docker-compose",
        "(^|/)k8s/",
        "(^|/)helm/",
        "(^|/)charts/",
        "serverless\\.yml"
      ],
      "emit": [
        "infrastructure",
        "deployment",
        "runtime"
      ]
    },
    {
      "when_imports": [
        "opentelemetry",
        "@opentelemetry/api",
        "prom-client",
        "datadog",
        "dd-trace",
        "sentry",
        "@sentry/node",
        "winston",
        "pino"
