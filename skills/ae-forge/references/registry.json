{
  "version": 1,
  "always": {
    "plan": ["probe"],
    "final": ["judge"]
  },
  "specialists": {
    "scout": {"owns":"opportunity evidence and alternatives","file":"specialists/scout.md","model":"strongest","triggers":["idea","market","competitor","research"]},
    "pulse": {"owns":"product outcome, value, scope, and success","file":"specialists/pulse.md","model":"strongest","triggers":["idea","product","feature"]},
    "rift": {"owns":"adversarial challenge of the product recommendation","file":"specialists/rift.md","model":"strongest","triggers":["idea","product"]},
    "flow": {"owns":"user journeys and experience acceptance","file":"specialists/flow.md","model":"strongest","triggers":["ui","ux","onboarding","journey","accessibility"]},
    "spine": {"owns":"system boundaries, interfaces, and material technical decisions","file":"specialists/spine.md","model":"strongest","triggers":["feature","architecture","integration","api"]},
    "pixel": {"owns":"client architecture and implemented user experience","file":"specialists/pixel.md","model":"standard","triggers":["ui","frontend","web","mobile"]},
    "core": {"owns":"service behavior, APIs, integrations, and server implementation","file":"specialists/core.md","model":"standard","triggers":["backend","api","service","integration"]},
    "shift": {"owns":"schema integrity, migrations, backfills, and data recovery","file":"specialists/shift.md","model":"strongest","triggers":["data","database","schema","migration","backfill"]},
    "vault": {"owns":"threats, authorization, privacy, and adversarial security verification","file":"specialists/vault.md","model":"strongest","triggers":["security","auth","authorization","tenant","secret","privacy","payment"]},
    "signal": {"owns":"failure behavior, performance, observability, and operational recovery","file":"specialists/signal.md","model":"strongest","triggers":["performance","reliability","concurrency","external","critical"]},
    "probe": {"owns":"independent acceptance and risk-based verification design","file":"specialists/probe.md","model":"standard","triggers":["feature","bug","refactor","performance","security","audit"]},
    "judge": {"owns":"integrated delivery-readiness judgment","file":"specialists/judge.md","model":"strongest","triggers":["feature","bug","refactor","performance","security","audit"]}
  },
  "lenses": {
    "exact": {"covers":["correctness","scope"],"file":"lenses/exact.md","escalates_to":"probe","triggers":["feature","bug","refactor"]},
    "compat": {"covers":["compatibility","contracts"],"file":"lenses/compat.md","escalates_to":"spine","triggers":["api","schema","dependency"]},
    "threat": {"covers":["security","abuse"],"file":"lenses/threat.md","escalates_to":"vault","triggers":["security","auth","external","payment"]},
    "tenancy": {"covers":["authorization","tenant-isolation"],"file":"lenses/tenancy.md","escalates_to":"vault","triggers":["auth","authorization","tenant"]},
    "integrity": {"covers":["data-integrity","concurrency"],"file":"lenses/integrity.md","escalates_to":"shift","triggers":["data","database","concurrency"]},
    "migrate": {"covers":["migration","recovery"],"file":"lenses/migrate.md","escalates_to":"shift","triggers":["schema","migration","backfill"]},
    "access": {"covers":["accessibility"],"file":"lenses/access.md","escalates_to":"flow","triggers":["ui","ux","accessibility"]},
    "journey": {"covers":["user-flow","interface-states"],"file":"lenses/journey.md","escalates_to":"flow","triggers":["ui","ux","onboarding","journey"]},
    "failure": {"covers":["failure-modes","degradation"],"file":"lenses/failure.md","escalates_to":"signal","triggers":["external","integration","critical"]},
    "speed": {"covers":["latency","capacity"],"file":"lenses/speed.md","escalates_to":"signal","triggers":["performance","database","critical"]},
    "observe": {"covers":["observability"],"file":"lenses/observe.md","escalates_to":"signal","triggers":["service","external","critical"]},
    "recover": {"covers":["rollback","recovery"],"file":"lenses/recover.md","escalates_to":"signal","triggers":["migration","release","critical"]}
  }
}
