{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/budget.schema.json",
  "title": "Agent Engineering reserved and consumed budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tier", "limits", "reserved", "consumed"],
  "properties": {
    "schema": {"const": 1},
    "tier": {"enum": ["small", "medium", "large"]},
    "limits": {"$ref": "#/$defs/counters"},
    "reserved": {"$ref": "#/$defs/counters"},
    "consumed": {"$ref": "#/$defs/counters"}
  },
  "$defs": {
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "output_tokens", "context_tokens", "wall_time_seconds", "repair_attempts", "specialist_escalations"],
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "context_tokens": {"type": "integer", "minimum": 0},
        "wall_time_seconds": {"type": "integer", "minimum": 0},
        "repair_attempts": {"type": "integer", "minimum": 0},
        "specialist_escalations": {"type": "integer", "minimum": 0}
      }
    }
  }
}
