{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/host-constraints.schema.json",
  "title": "Non-expandable host and user constraints",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "allowed_tools", "allowed_write_roots", "network", "max_budget_tier", "model_profiles", "release_outputs"],
  "properties": {
    "schema": {"const": 1},
    "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_write_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "network": {"type": "boolean"},
    "max_budget_tier": {"enum": ["small", "medium", "large"]},
    "model_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["smaller-model-only", "mixed"]}},
    "release_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "pr_ready_branch"}}
  }
}
