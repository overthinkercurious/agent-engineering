{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/host-config.schema.json",
  "title": "Forge host launch configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "command", "args", "deterministic", "cacheable", "timeout_ms"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "command": {"type": "string", "minLength": 1},
    "args": {"type": "array", "items": {"type": "string"}},
    "deterministic": {"type": "boolean"},
    "cacheable": {"type": "boolean"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000}
  }
}
