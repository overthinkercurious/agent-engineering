{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/risk-assessment.schema.json",
  "title": "Recorded adaptive risk assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "current", "history"],
  "properties": {
    "schema": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "current": {"$ref": "#/$defs/event"},
    "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "source", "candidate_identity", "inputs", "dimensions", "classified_tier", "policy_floor", "effective_tier", "tier_changed", "diagnosis_required", "added_specialists", "added_lenses", "reasons"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "source": {"enum": ["intake", "signal_update", "completed_diff"]},
        "candidate_identity": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "explicit_signals", "affected_behaviors", "interfaces", "diff_paths", "diff_sha256", "filename_leads", "explicit_dimensions"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "explicit_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "affected_behaviors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "interfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "diff_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "diff_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "filename_leads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "explicit_dimensions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["blast_radius", "irreversibility", "sensitivity", "uncertainty", "cross_system"],
              "properties": {
                "blast_radius": {"type": ["string", "null"], "enum": ["isolated", "component", "cross_system", null]},
                "irreversibility": {"type": ["string", "null"], "enum": ["reversible", "costly", "irreversible", null]},
                "sensitivity": {"type": ["string", "null"], "enum": ["none", "data", "security", null]},
                "uncertainty": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
                "cross_system": {"type": "boolean"}
              }
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blast_radius", "irreversibility", "sensitivity", "uncertainty", "cross_system_scope"],
          "properties": {
            "blast_radius": {"enum": ["isolated", "component", "cross_system"]},
            "irreversibility": {"enum": ["reversible", "costly", "irreversible"]},
            "sensitivity": {"enum": ["none", "data", "security"]},
            "uncertainty": {"enum": ["low", "medium", "high"]},
            "cross_system_scope": {"type": "boolean"}
          }
        },
        "classified_tier": {"enum": ["light", "standard", "deep"]},
        "policy_floor": {"enum": ["light", "standard", "deep"]},
        "effective_tier": {"enum": ["light", "standard", "deep"]},
        "tier_changed": {"type": "boolean"},
        "diagnosis_required": {"type": "boolean"},
        "added_specialists": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "added_lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
