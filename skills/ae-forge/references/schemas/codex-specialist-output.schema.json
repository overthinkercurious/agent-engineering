{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/codex-specialist-output.schema.json",
  "title": "Codex-authored specialist result without host-owned usage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "dispatch_id", "specialist", "status", "outcome", "summary", "evidence", "assumptions", "unknowns", "confidence", "diagnosis", "artifact_changes", "findings", "needs_specialist"],
  "properties": {
    "schema": {"type": "integer", "enum": [2]},
    "run_id": {"type": "string"},
    "dispatch_id": {"type": "string"},
    "specialist": {"type": "string"},
    "status": {"type": "string", "enum": ["complete", "needs_input", "needs_specialist", "blocked", "failed"]},
    "outcome": {"type": "string"},
    "summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "claim"],
        "properties": {
          "id": {"type": "string"},
          "class": {"type": "string", "enum": ["OBSERVED", "MEASURED", "INFERRED", "ASSUMED", "UNKNOWN", "DECIDED"]},
          "claim": {"type": "string"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
        "basis": {"type": "string"}
      }
    },
    "diagnosis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["symptom", "observation_ids", "hypotheses", "established_cause", "contributing_factors", "remaining_uncertainty"],
      "properties": {
        "symptom": {"type": "string"},
        "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "discriminating_test", "result", "evidence_ids", "disposition"],
            "properties": {
              "id": {"type": "string"},
              "statement": {"type": "string"},
              "discriminating_test": {"type": "string"},
              "result": {"type": "string"},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "disposition": {"type": "string", "enum": ["supported", "disproved", "unresolved"]}
            }
          }
        },
        "established_cause": {"type": ["string", "null"]},
        "contributing_factors": {"type": "array", "items": {"type": "string"}},
        "remaining_uncertainty": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "action": {"type": "string", "enum": ["created", "updated", "deleted", "none"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "id", "lens", "severity", "criterion", "invariant", "evidence_ids", "affected_behavior", "smallest_repair", "verification", "status"],
        "properties": {
          "schema": {"type": "integer", "enum": [2]},
          "id": {"type": "string", "pattern": "^finding:[a-f0-9]{16}$"},
          "lens": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "criterion": {"type": "string"},
          "invariant": {"type": "string"},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "affected_behavior": {"type": "string"},
          "smallest_repair": {"type": "string"},
          "verification": {"type": "string"},
          "status": {"type": "string", "enum": ["open", "accepted", "fixed", "not_applicable"]}
        }
      }
    },
    "needs_specialist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["specialty", "reason", "missing_inputs", "blocking"],
        "properties": {
          "specialty": {"type": "string"},
          "reason": {"type": "string"},
          "missing_inputs": {"type": "array", "items": {"type": "string"}},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
