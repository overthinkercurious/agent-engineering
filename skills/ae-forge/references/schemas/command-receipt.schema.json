{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/command-receipt.schema.json",
  "title": "Runner-owned command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "run_id", "invocation", "args", "cwd", "started_at", "finished_at", "exit_code", "output_sha256", "output_bytes", "candidate_identity", "evidence_class", "issuer"],
  "properties": {
    "schema": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation": {"type": "string", "minLength": 1},
    "args": {"type": "array", "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": "integer"},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_bytes": {"type": "integer", "minimum": 0},
    "candidate_identity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_class": {"const": "MEASURED"},
    "issuer": {"const": "forge"}
  }
}
