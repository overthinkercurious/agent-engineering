{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/operation-receipt.schema.json",
  "title": "Idempotent Forge operation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "kind", "feature_id", "status", "created_at", "updated_at", "authority", "reservation", "actual", "telemetry"],
  "properties": {
    "schema": {"const": 1},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "kind": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "status": {"enum": ["reserved", "acknowledged", "failed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "authority": {
      "type": "object", "additionalProperties": false, "required": ["tool", "write_paths", "network"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "network": {"type": "boolean"}
      }
    },
    "reservation": {"$ref": "budget.schema.json#/$defs/counters"},
    "actual": {"type": ["object", "null"], "additionalProperties": false, "required": ["calls", "input_tokens", "output_tokens", "context_tokens", "wall_time_seconds", "repair_attempts", "specialist_escalations"], "properties": {
      "calls": {"type": "integer", "minimum": 0},
      "input_tokens": {"type": ["integer", "null"], "minimum": 0},
      "output_tokens": {"type": ["integer", "null"], "minimum": 0},
      "context_tokens": {"type": "integer", "minimum": 0},
      "wall_time_seconds": {"type": "integer", "minimum": 0},
      "repair_attempts": {"type": "integer", "minimum": 0},
      "specialist_escalations": {"type": "integer", "minimum": 0}
    }},
    "telemetry": {"enum": ["measured", "estimated", "unavailable"]}
  }
}
