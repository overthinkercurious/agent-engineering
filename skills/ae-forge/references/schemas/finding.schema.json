{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/finding.schema.json",
  "title": "Canonical review finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "lens", "severity", "criterion", "invariant", "evidence_ids", "affected_behavior", "smallest_repair", "verification", "status"],
  "properties": {
    "schema": {"const": 2},
    "id": {"type": "string", "pattern": "^finding:[a-f0-9]{16}$"},
    "lens": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "criterion": {"type": "string", "minLength": 1},
    "invariant": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "affected_behavior": {"type": "string", "minLength": 1},
    "smallest_repair": {"type": "string", "minLength": 1},
    "verification": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "accepted", "fixed", "not_applicable"]}
  }
}
