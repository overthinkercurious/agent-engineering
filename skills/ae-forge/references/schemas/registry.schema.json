{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/registry.schema.json",
  "title": "Forge specialist and lens registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "always", "specialists", "lenses"],
  "properties": {
    "version": {"const": 1},
    "always": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "final"],
      "properties": {
        "plan": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "final": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "specialists": {"type": "object", "additionalProperties": {"$ref": "#/$defs/specialist"}},
    "lenses": {"type": "object", "additionalProperties": {"$ref": "#/$defs/lens"}}
  },
  "$defs": {
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "file", "model", "triggers"],
      "properties": {
        "owns": {"type": "string", "minLength": 1},
        "file": {"type": "string", "pattern": "^specialists/[a-z0-9-]+\\.md$"},
        "model": {"enum": ["standard", "strongest"]},
        "triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covers", "file", "escalates_to", "triggers"],
      "properties": {
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "file": {"type": "string", "pattern": "^lenses/[a-z0-9-]+\\.md$"},
        "escalates_to": {"type": "string", "minLength": 1},
        "triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
