{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/release-policy.schema.json",
  "title": "Project release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "source_revision", "target", "production_deployment_authorized", "requires", "judgment"],
  "properties": {
    "schema": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "judgment_provenance": {"type": "object", "additionalProperties": {"enum": ["unresolved", "preserved_user_decision", "user_confirmed_conservative_default"]}},
    "target": {"const": "pr_ready_branch"},
    "production_deployment_authorized": {"const": false},
    "requires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_command", "rollback_or_recovery"],
      "properties": {
        "preview_command": {"type": "string", "minLength": 1},
        "rollback_or_recovery": {"type": "string", "minLength": 1}
      }
    }
  }
}
