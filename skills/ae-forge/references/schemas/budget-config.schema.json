{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/budget-config.schema.json",
  "title": "Agent Engineering budget defaults",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "default_by_kind", "tiers", "hard_maximum", "development"],
  "properties": {
    "schema": {"const": 1},
    "contract_version": {"const": 1},
    "default_by_kind": {
      "type": "object",
      "additionalProperties": {"enum": ["small", "medium", "large"]}
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small", "medium", "large"],
      "properties": {
        "small": {"$ref": "budget.schema.json#/$defs/counters"},
        "medium": {"$ref": "budget.schema.json#/$defs/counters"},
        "large": {"$ref": "budget.schema.json#/$defs/counters"}
      }
    },
    "hard_maximum": {"$ref": "budget.schema.json#/$defs/counters"},
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_charge_usd", "per_fixture_charge_usd"],
      "properties": {
        "total_charge_usd": {"type": "number", "minimum": 0},
        "per_fixture_charge_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
