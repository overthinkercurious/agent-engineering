{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/host-adapter.schema.json",
  "title": "Observed Forge host capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter_id", "model_id", "model_class", "isolation", "fresh_context", "per_dispatch_model_selection", "usage_telemetry", "tool_write_enforcement", "cancellation_acknowledgement", "observation_source"],
  "properties": {
    "schema": {"const": 1},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "model_id": {"type": "string", "minLength": 1},
    "model_class": {"enum": ["smaller", "strongest", "single-host-model"]},
    "isolation": {"enum": ["fresh_process", "fresh_agent", "shared_context"]},
    "fresh_context": {"enum": ["available", "unavailable", "unknown"]},
    "per_dispatch_model_selection": {"enum": ["available", "unavailable", "unknown"]},
    "usage_telemetry": {"enum": ["available", "unavailable", "unknown"]},
    "tool_write_enforcement": {"enum": ["available", "unavailable", "unknown"]},
    "cancellation_acknowledgement": {"enum": ["available", "unavailable", "unknown"]},
    "observation_source": {"type": "string", "minLength": 1}
  }
}
