{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/quality-policy.schema.json",
  "title": "Project quality-gates policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "source_revision", "required_commands", "evidence_rules", "judgment"],
  "properties": {
    "schema": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "judgment_provenance": {"type": "object", "additionalProperties": {"enum": ["unresolved", "preserved_user_decision", "user_confirmed_conservative_default"]}},
    "required_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "command"],
        "properties": {
          "kind": {"enum": ["test", "typecheck", "lint", "build", "security", "smoke", "custom"]},
          "command": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind_to_candidate_revision", "model_pass_is_advisory", "heuristics_must_be_labeled"],
      "properties": {
        "bind_to_candidate_revision": {"const": true},
        "model_pass_is_advisory": {"const": true},
        "heuristics_must_be_labeled": {"const": true}
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_user_journeys", "non_functional_budgets"],
      "properties": {
        "required_user_journeys": {"type": "string", "minLength": 1},
        "non_functional_budgets": {"type": "string", "minLength": 1}
      }
    }
  }
}
