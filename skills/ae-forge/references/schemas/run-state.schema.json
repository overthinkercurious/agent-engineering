{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/run-state.schema.json",
  "title": "Agent Engineering run state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "feature_id", "status", "updated_at", "completed", "active", "open_findings", "open_decisions", "budget", "usage", "candidate", "pause", "operation", "repair_cycle"],
  "properties": {
    "schema": {"const": 2},
    "contract_version": {"const": 1},
    "feature_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "status": {"enum": ["created", "classified", "discovery", "definition", "plan_review", "awaiting_approval", "approved", "implementation", "integration", "audit", "verification", "repair", "awaiting_specialist", "blocked", "halted", "ready_for_pr", "complete", "cancelled"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed": {"type": "array", "uniqueItems": true, "items": {"enum": ["created", "classified", "discovery", "definition", "plan_review", "awaiting_approval", "approved", "implementation", "integration", "audit", "verification", "repair", "awaiting_specialist", "blocked", "halted", "ready_for_pr"]}},
    "active": {"type": ["string", "null"]},
    "open_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^finding:[a-f0-9]{16}$"}},
    "open_decisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget": {"$ref": "budget.schema.json"},
    "usage": {"$ref": "usage.schema.json"},
    "candidate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["commit", "worktree_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
        "worktree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "pause": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["prior_state", "reason_code", "resume_action", "attempt", "policy_digest", "candidate_digest"],
      "properties": {
        "prior_state": {"enum": ["created", "classified", "discovery", "definition", "plan_review", "awaiting_approval", "approved", "implementation", "integration", "audit", "verification", "repair", "ready_for_pr"]},
        "reason_code": {"type": "string", "minLength": 1},
        "resume_action": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 0},
        "policy_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "candidate_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "operation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "kind", "attempt", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 0},
        "status": {"enum": ["reserved", "running", "acknowledged", "failed", "cancel_requested", "cancelled"]}
      }
    },
    "repair_cycle": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["attempt", "finding_ids", "implementation_complete", "reaudit_complete", "retest_complete"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^finding:[a-f0-9]{16}$"}},
        "implementation_complete": {"type": "boolean"},
        "reaudit_complete": {"type": "boolean"},
        "retest_complete": {"type": "boolean"}
      }
    }
  }
}
