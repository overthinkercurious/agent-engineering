{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/context-packet.schema.json",
  "title": "Bounded specialist context packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_id", "run_id", "dispatch_id", "stage", "specialist", "request", "acceptance_ids", "inputs", "allowed_tools", "allowed_writes", "budget", "output_schema", "policy_digest", "candidate_identity", "brief_id", "workflow_path", "workflow_sha256", "contract_path", "contract_sha256", "dependency_key", "host_config_path", "routing_chain", "max_result_bytes", "host_execution"],
  "properties": {
    "schema": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "specialist": {"type": "string", "minLength": 1},
    "request": {"type": "string", "minLength": 1},
    "acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget": {"$ref": "budget.schema.json#/$defs/counters"},
    "output_schema": {"type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_identity": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "brief_id": {"type": "string", "minLength": 1},
    "workflow_path": {"type": "string", "minLength": 1},
    "workflow_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_path": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host_config_path": {"type": "string", "minLength": 1},
    "routing_chain": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_result_bytes": {"type": "integer", "minimum": 1},
    "host_execution": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "model_id", "isolation", "fresh_context", "per_dispatch_model_selection", "usage_telemetry", "tool_write_enforcement", "cancellation_acknowledgement", "model_selection_reason"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "isolation": {"enum": ["fresh_process", "fresh_agent", "shared_context"]},
        "fresh_context": {"enum": ["available", "unavailable", "unknown"]},
        "per_dispatch_model_selection": {"enum": ["available", "unavailable", "unknown"]},
        "usage_telemetry": {"enum": ["available", "unavailable", "unknown"]},
        "tool_write_enforcement": {"enum": ["available", "unavailable", "unknown"]},
        "cancellation_acknowledgement": {"enum": ["available", "unavailable", "unknown"]}
        ,"model_selection_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
