{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering.dev/schemas/specialist-result.schema.json",
  "title": "Specialist result envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "dispatch_id", "specialist", "status", "outcome", "summary", "evidence", "assumptions", "unknowns", "confidence", "artifact_changes", "findings", "needs_specialist", "usage"],
  "properties": {
    "schema": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "specialist": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "needs_input", "needs_specialist", "blocked", "failed"]},
    "outcome": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "claim"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"enum": ["OBSERVED", "MEASURED", "INFERRED", "ASSUMED", "UNKNOWN", "DECIDED"]},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unknowns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": {"enum": ["high", "medium", "low", "unknown"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "diagnosis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["symptom", "observation_ids", "hypotheses", "established_cause", "contributing_factors", "remaining_uncertainty"],
      "properties": {
        "symptom": {"type": "string", "minLength": 1},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "discriminating_test", "result", "evidence_ids", "disposition"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1},
              "discriminating_test": {"type": "string", "minLength": 1},
              "result": {"type": "string", "minLength": 1},
              "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "disposition": {"enum": ["supported", "disproved", "unresolved"]}
            }
          }
        },
        "established_cause": {"type": ["string", "null"], "minLength": 1},
        "contributing_factors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "remaining_uncertainty": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifact_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "action": {"enum": ["created", "updated", "deleted", "none"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "needs_specialist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["specialty", "reason", "missing_inputs", "blocking"],
        "properties": {
          "specialty": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "missing_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "usage": {"$ref": "usage.schema.json"}
  }
}
